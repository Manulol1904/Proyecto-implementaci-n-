APP_ENV=dev
LOG_LEVEL=INFO

# MongoDB
# - Dev: se usa el contenedor `mongo` del compose
# - Prod: reemplaza por tu string de MongoDB Atlas
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=cobros_residenciales

# JWT
JWT_SECRET=change-me-super-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Redis
REDIS_URL=redis://redis:6379/0

# Negocio
ADMIN_FEE_BASE_COP=300000
INVOICE_DUE_DAY=10

# Factus (opcional en dev)
FACTUS_HOST=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
FACTUS_NUMBERING_RANGE_ID=

# Pagos
PAYMENTS_PROVIDER=mock
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_WEBHOOK_SECRET=

# Frontend
VITE_BACKEND_URL=http://localhost:8000
VITE_PAYMENTS_URL=http://localhost:8002

