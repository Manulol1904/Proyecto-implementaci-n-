### Producción gratuita (Oracle VM + Atlas + túnel HTTPS)
APP_ENV=prod
LOG_LEVEL=INFO

### MongoDB Atlas (gratis M0) — https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=cobros_residenciales

### Auth — genera uno largo: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

### Redis (en la misma VM con docker-compose.prod)
REDIS_URL=redis://redis:6379/0

### URLs públicas (las que verá el navegador tras el túnel o tu dominio)
VITE_BACKEND_URL=https://api-TU-SUBDOMINIO.trycloudflare.com
VITE_PAYMENTS_URL=https://pay-TU-SUBDOMINIO.trycloudflare.com
# Si usas un solo túnel al frontend y proxy /api, ajusta según tu nginx (ver DEPLOY_GRATIS.md)

### CORS — origen exacto del frontend (HTTPS, sin barra final)
CORS_EXTRA_ORIGINS=https://TU-FRONTEND.trycloudflare.com

### Servicios internos Docker
BACKEND_INTERNAL_URL=http://backend:8000
PAYMENTS_INTERNAL_URL=http://payments:8002
BACKEND_URL=http://backend:8000

### Negocio
ADMIN_FEE_BASE_COP=300000
INVOICE_DUE_DAY=10
VISITOR_PARKING_HOURLY_COP=2000
SOCIAL_HALL_DAILY_COP=150000
GYM_MONTHLY_COP=40000
RESERVATION_PENDING_EXPIRE_MINUTES=30
FACTUS_RETRY_LIMIT=25

### Factus (opcional)
FACTUS_HOST=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
FACTUS_NUMBERING_RANGE_ID=
