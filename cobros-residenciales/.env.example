### Shared
APP_ENV=dev
LOG_LEVEL=INFO

### MongoDB
# Dev (compose): mongodb://mongo:27017
# Prod (Atlas): mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=cobros_residenciales

### Auth (JWT)
JWT_SECRET=change-me-super-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

### Redis (Celery broker)
REDIS_URL=redis://redis:6379/0

### Business
# Valor global mensual de administración (COP)
ADMIN_FEE_BASE_COP=300000
# Día de vencimiento del mes (1-28 recomendado)
INVOICE_DUE_DAY=10

### Reservas y servicios
# Parqueadero de visitantes (por hora)
VISITOR_PARKING_HOURLY_COP=2000
# Salón comunal (por día)
SOCIAL_HALL_DAILY_COP=150000
# Gimnasio (mensual)
GYM_MONTHLY_COP=40000

### Automatizaciones worker
# Minutos antes de cancelar una reserva pendiente sin pago
RESERVATION_PENDING_EXPIRE_MINUTES=30
# Minutos antes de reconciliar pagos mock creados y no confirmados (solo APP_ENV=dev)
PAYMENT_RECONCILE_AFTER_MINUTES=30
# Máximo de facturas Factus a reintentar por corrida automática
FACTUS_RETRY_LIMIT=25
# URLs internas Docker para health-check del worker
BACKEND_INTERNAL_URL=http://backend:8000
PAYMENTS_INTERNAL_URL=http://payments:8002

### Factus (facturación electrónica)
# Host API (sandbox / prod)
FACTUS_HOST=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
# requerido por /v2/bills/validate
FACTUS_NUMBERING_RANGE_ID=

### Service URLs (frontend)
VITE_BACKEND_URL=http://localhost:8000
VITE_PAYMENTS_URL=http://localhost:8002
